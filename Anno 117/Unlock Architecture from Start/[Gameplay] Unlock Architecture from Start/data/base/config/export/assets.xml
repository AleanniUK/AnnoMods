  <!-- Runtime road unlock for existing saves. -->
  <ModOp Type="addNextSibling" GUID="55125">
    <Asset>
      <Template>Trigger</Template>
      <Values>
        <Standard>
          <GUID>1999091303</GUID>
          <Name>Migration 1.5 Unlock Vanilla Roads</Name>
        </Standard>
        <Locked />
        <Trigger>
          <TriggerCondition>
            <Template>ConditionTimer</Template>
            <Values>
              <Condition />
              <ConditionTimer>
                <TimeLimit>1000</TimeLimit>
              </ConditionTimer>
            </Values>
            <IsBaseAutoCreateAsset>0</IsBaseAutoCreateAsset>
          </TriggerCondition>
          <TriggerActions>
            <Item>
              <TriggerAction>
                <Template>ActionUnlockAsset</Template>
                <Values>
                  <Action />
                  <ActionUnlockAsset>
